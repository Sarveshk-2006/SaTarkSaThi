# ──────────────────────────────────────────────────────────────
# Satark Saathi — Environment Configuration Template
# Copy to backend/.env and fill in values for your environment.
# NEVER commit real credentials. All secrets must come from .env.
# ──────────────────────────────────────────────────────────────

APP_NAME="Satark Saathi API"
APP_ENV="development"
DEBUG=false
PORT=8000
HOST="0.0.0.0"
DATABASE_URL="sqlite:///./satark_saathi.db"

# CORS: comma-separated list of allowed frontend origins.
# The wildcard "*" is NOT used — add your frontend URL here.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ── AI Engine ─────────────────────────────────────────────────
# Set ANALYSIS_PROVIDER=rule_based to run the deterministic rule engine (default).
# Set ANALYSIS_PROVIDER=watsonx AND supply WATSONX_APIKEY + WATSONX_PROJECT_ID
# to enable IBM watsonx.ai Granite-13b inference.
ANALYSIS_PROVIDER="rule_based"
WATSONX_APIKEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID="ibm/granite-13b-chat-v2"

# ── SMS / Telecom Gateway ─────────────────────────────────────
# Leave all values empty to use the in-app simulation (default).
# Set SMS_PROVIDER=twilio or fast2sms and supply credentials to send real SMS.
SMS_PROVIDER="simulated"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
FAST2SMS_API_KEY=""

# ── Authentication & JWT Security ──────────────────────────────
# REQUIRED FOR PRODUCTION: Set a strong, unique secret (minimum 32 characters).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="satark_saathi_dev_secret_key_change_in_production_min32chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ISSUER="satark-saathi-auth"
JWT_AUDIENCE="satark-saathi-app"
# MUST BE FALSE IN PRODUCTION. When false or in production, X-User-Id header is rejected.
ALLOW_DEMO_HEADER_AUTH=true

# ── Demo Settings ─────────────────────────────────────────────
ENABLE_DEMO_SEED=true
